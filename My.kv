<EnterLostChildDetails>:
    name: 'EnterLostChildDetails'
    Image:
        source: './Camera Roll./Untitled-26.png'
        pos: self.pos
        size: self.size

    Button:
        text: ""
        text_color: get_color_from_hex('#494646')
        md_bg_color: get_color_from_hex('#DDF0E9')
        pos_hint: {'center_x': 0.5, 'center_y': 0.78}
        on_release: root.pff_change()
        size_hint: 0.25, 0.09


        Image:
            id: Pg3im1
            source: './Camera Roll./Untitled-27.png'
            center_x: self.parent.center_x
            center_y: self.parent.center_y
            size: dp(180), dp(90)

    TextInput:
        id: name_input
        hint_text: "Enter Name "
        size_hint: 0.5, 0.06
        pos_hint: {'center_x': 0.6, 'center_y': 0.565}

    TextInput:
        id: age_input
        hint_text: "Enter Age "
        size_hint: 0.5, 0.06
        pos_hint: {'center_x': 0.5, 'center_y': 0.479}

    TextInput:
        id: date_input
        hint_text: "Missing Since Date "
        size_hint: 0.5, 0.06
        pos_hint: {'center_x': 0.65, 'center_y': 0.389}

    TextInput:
        id: mobile_input
        hint_text: "guardians mobile no"
        size_hint: 0.5, 0.06
        pos_hint: {'center_x': 0.6, 'center_y': 0.3}

    TextInput:
        id: address_input
        hint_text: "Address"
        size_hint: 0.5, 0.06
        multiline: True
        pos_hint: {'center_x': 0.55, 'center_y': 0.22}

    Button:
        text: ""
        text_color: get_color_from_hex('#494646')
        md_bg_color: get_color_from_hex('#DDF0E9')
        pos_hint: {'center_x': 0.5, 'center_y': 0.1}
        on_release:
            root.save_data(self)
            app.root.current = 'Demo'
        size_hint: 0.7, 0.09


        Image:
            id: pg3im2
            source: './Camera Roll./Untitled-28.png'
            center_x: self.parent.center_x
            center_y: self.parent.center_y
            size: dp(250), dp(150)


<RoundedButton@Button>    
    background_color: (0,0,0,0)
    background_normal:
    canvas.before:
        Color:
            rgba: get_color_from_hex('81CBAA')
        RoundedRectangle:
            size: self.size
            pos: self.pos
            radius: [20]

<RoundedButton2@Button>
    background_color: (0,0,0,0)
    background_normal:
    canvas.before:
        Color:
            rgba: get_color_from_hex('DDF0E9')
        RoundedRectangle:
            size: self.size
            pos: self.pos
            radius: [20]

