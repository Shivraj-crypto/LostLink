            source: './Images/ScanFace.png'
            radius: [20]


<Imageandbackground@Button> 
    background_color: (0,0,0,0)
    background_normal:
    canvas.before:
        Color:
            rgb: 1, 1, 1     
        Ellipse:
            pos: 100, 305
            size: 100 , 100 
            source: '../Camera Roll./Untitled-27.png'
            angle_start: 0
            angle_end: 360


